/* CortexShift control center theme.
 *
 * A restrained engineering palette: dark ground, one accent, subtle borders, and
 * status emphasis reserved for state that actually needs attention. Meaning is never
 * carried by colour alone — glyphs accompany every status marker.
 */

Screen {
    background: $surface;
    color: $foreground;
}

/* ---------- Shell layout ---------- */

#shell {
    height: 1fr;
}

#sidebar {
    width: 20;
    min-width: 20;
    background: $panel;
    border-right: solid $primary-darken-2;
    padding: 1 1 0 1;
}

#sidebar-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 1;
}

#nav {
    height: auto;
    border: none;
    background: $panel;
}

#nav > .option-list--option {
    padding: 0 0;
}

#nav:focus > .option-list--option-highlighted {
    background: $primary;
    color: $text;
    text-style: bold;
}

#content {
    padding: 1 2;
    height: 1fr;
}

#status-line {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* Compact layout for terminals narrower than 90 columns: the sidebar folds away and
   the section name moves into the status line. Number keys keep working. */

.compact #sidebar {
    display: none;
}

.compact #content {
    padding: 1 1;
}

/* ---------- Sections ---------- */

.section {
    height: 1fr;
    overflow-y: auto;
}

.section-title {
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
}

.panel {
    height: auto;
    border-top: solid $primary-darken-2;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-style: italic;
    padding: 0 0 1 0;
    margin: 1 0 0 0;
}

.panel-title {
    color: $text-muted;
    text-style: bold;
    padding: 1 0 0 0;
}

.field-list {
    height: auto;
    padding: 0 0 0 1;
}

.bullets {
    height: auto;
    padding: 0 0 0 0;
}

.columns {
    height: auto;
}

.column {
    width: 1fr;
    height: auto;
    padding: 0 2 0 0;
}

.empty-state {
    padding: 2 2;
    color: $text-muted;
}

.notice {
    padding: 0 0 1 0;
    color: $warning;
}

/* ---------- Tables ---------- */

DataTable {
    height: auto;
    max-height: 20;
    border: round $primary-darken-2;
}

DataTable > .datatable--header {
    text-style: bold;
    background: $panel;
    color: $text-muted;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $text;
}

.detail {
    height: auto;
    border-top: solid $primary-darken-2;
    padding: 1 0 0 0;
}

/* ---------- Status emphasis ---------- */

.state-ok {
    color: $success;
}

.state-warn {
    color: $warning;
}

.state-fail {
    color: $error;
}

.state-active {
    color: $accent;
}

.state-muted {
    color: $text-muted;
}

/* ---------- Modals ---------- */

ModalScreen {
    align: center middle;
    background: $surface 60%;
}

.modal {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $panel;
    border: thick $primary;
}

.modal-title {
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
}

.modal-help {
    color: $text-muted;
    padding: 0 0 1 0;
}

.modal-error {
    color: $error;
    height: auto;
    padding: 0 0 1 0;
}

.modal-body {
    height: auto;
    max-height: 24;
    overflow-y: auto;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
    padding: 1 0 0 0;
}

.modal-buttons Button {
    margin: 0 0 0 2;
    min-width: 12;
}

.field-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

Input {
    border: tall $primary-darken-2;
}

Input:focus {
    border: tall $accent;
}

/* ---------- Too-small terminal guard ---------- */

#too-small {
    display: none;
    height: 1fr;
    padding: 1 2;
    color: $warning;
}

.too-small #shell {
    display: none;
}

.too-small #too-small {
    display: block;
}
